# The demo binds only to 127.0.0.1 and rejects NODE_ENV=production.
NODE_ENV=development
# Local Fastify port.
PORT=4000
# Optional Vite BFF proxy override, used by isolated browser tests.
API_PROXY_TARGET=http://127.0.0.1:4000
# Relative to apps/api when started through pnpm dev.
DEMO_DATA_PATH=../../.data/demo.json
# Used by Docker Compose for local PostgreSQL. Change before starting infrastructure.
POSTGRES_PASSWORD=local-development-only
# Reserved for the AI milestone; no model names are hard-coded.
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
# Configure locally when agent execution is added; never commit a real key.
GOOGLE_API_KEY=
