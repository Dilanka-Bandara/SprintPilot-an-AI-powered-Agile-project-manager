# The demo binds only to 127.0.0.1 and rejects NODE_ENV=production.
NODE_ENV=development
# Local Fastify port.
PORT=4000
# Optional Vite BFF proxy override, used by isolated browser tests.
API_PROXY_TARGET=http://127.0.0.1:4000
# Relative to apps/api when started through pnpm dev.
DEMO_DATA_PATH=../../.data/demo.json
# Used by Docker Compose for local PostgreSQL. Change before starting infrastructure.
POSTGRES_PASSWORD=local-development-only
# Host port for the project-owned PostgreSQL container (avoids existing databases).
POSTGRES_PORT=55432
# Opt in to authenticated PostgreSQL workspaces after running migrations.
WORKSPACES_ENABLED=false
# Match POSTGRES_PASSWORD and POSTGRES_PORT above; keep real credentials in .env.
DATABASE_URL=postgresql://sprintpilot:local-development-only@127.0.0.1:55432/sprintpilot?schema=public
# Firebase project used to verify signed ID tokens on the API.
FIREBASE_PROJECT_ID=
# Public web-app configuration from Firebase Console; Analytics is not initialized.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional dedicated PostgreSQL database URL for integration tests.
# TEST_DATABASE_URL=
# Reserved for the AI milestone; no model names are hard-coded.
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
# Configure locally when agent execution is added; never commit a real key.
GOOGLE_API_KEY=
